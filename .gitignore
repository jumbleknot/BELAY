# ---------------------------------------------------------------------------
# OS
# ---------------------------------------------------------------------------
.DS_Store
._*
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

# ---------------------------------------------------------------------------
# Editors / IDEs
# ---------------------------------------------------------------------------
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
*.code-workspace
.idea/
*.iml
*.swp
*.swo
*~
.history/

# Claude Code: personal settings stay local; shared .claude/ config is tracked
.claude/settings.local.json

# ---------------------------------------------------------------------------
# Secrets and local environment
# ---------------------------------------------------------------------------
.env
.env.*
!.env.example
*.pem
*.key
*.pfx
*.p12
# secrets/ folders are tracked, but only for placeholders, docs and templates
**/secrets/*
!**/secrets/.gitkeep
!**/secrets/README.md
!**/secrets/*.example
.secrets/

# ---------------------------------------------------------------------------
# Logs, temp and coverage
# ---------------------------------------------------------------------------
*.log
logs/
tmp/
temp/
*.tmp
coverage/
*.lcov
.nyc_output/

# ---------------------------------------------------------------------------
# Node / JavaScript / TypeScript
# ---------------------------------------------------------------------------
# No trailing slash: it must also match a node_modules SYMLINK in a git worktree.
node_modules
.pnpm-store/
.nx/
.npm/
.yarn/*
!.yarn/releases
!.yarn/plugins
dist/
.next/
.turbo/
.cache/
*.tsbuildinfo

# ---------------------------------------------------------------------------
# Python
# ---------------------------------------------------------------------------
__pycache__/
*.py[cod]
.venv/
venv/
.python-version
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.tox/
.coverage
htmlcov/

# ---------------------------------------------------------------------------
# Rust (Cargo.lock is intentionally tracked)
# ---------------------------------------------------------------------------
target/

# ---------------------------------------------------------------------------
# Go
# ---------------------------------------------------------------------------
*.test
*.out
go.work.sum

# ---------------------------------------------------------------------------
# .NET / Java / JVM
# ---------------------------------------------------------------------------
bin/
obj/
*.user
.gradle/
build/
out/
*.class

# ---------------------------------------------------------------------------
# Infrastructure / DevSecOps
# ---------------------------------------------------------------------------
.terraform/
*.tfstate
*.tfstate.*
*.tfvars
!*.tfvars.example
crash.log
.terragrunt-cache/

# SAST/SCA scan output (feature 006): normalized findings and each scanner's native output are never
# committed. The tree (README, scan.yaml, semgrep.yaml, severity-map.yaml, rules/, allowlist.yaml)
# stays tracked; only the reports are ignored, as in MCM.
security/sast/reports/*
security/images/reports/
!security/sast/reports/.gitkeep

# Claude Code worktrees (claude --worktree) are scratch checkouts, never committed
.claude/worktrees
