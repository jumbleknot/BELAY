# Normalize line endings: store and check out text files as LF on every platform
* text=auto eol=lf

# Windows-only scripts need CRLF
*.bat   text eol=crlf
*.cmd   text eol=crlf
*.ps1   text eol=crlf
*.psm1  text eol=crlf
*.psd1  text eol=crlf
*.sln   text eol=crlf

# Spec Kit-managed scripts: keep the line endings Spec Kit writes (LF) so the
# hashes in .specify/integrations/*.manifest.json still match on checkout
.specify/scripts/**/*.ps1 text eol=lf
# Spec Kit extension scripts (specify extension add): same reason, LF as installed
.specify/extensions/**/*.ps1 text eol=lf

# Shell scripts must stay LF
*.sh    text eol=lf
*.bash  text eol=lf

# Diff hints
*.md    text diff=markdown
*.py    text diff=python
*.rs    text diff=rust
*.go    text diff=golang
*.cs    text diff=csharp
*.java  text diff=java
*.html  text diff=html
*.css   text diff=css

# Lock files: treat as generated, don't merge or diff noisily
*.lock            -diff linguist-generated
package-lock.json -diff linguist-generated
pnpm-lock.yaml    -diff linguist-generated

# Binary files
*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.ico   binary
*.webp  binary
*.pdf   binary
*.zip   binary
*.gz    binary
*.tar   binary
*.7z    binary
*.jar   binary
*.dll   binary
*.exe   binary
*.so    binary
*.dylib binary
*.woff  binary
*.woff2 binary
*.ttf   binary
*.otf   binary

# Test fixtures keep their EXACT bytes (ported from MovieCollectionManager). `* text=auto eol=lf`
# above normalizes on add. That is right for real documents and WRONG for a fixture whose CRLF IS the
# subject under test: scripts/__tests__/fixtures/openwiki-governance/whitespace-drift/ proves that
# check-openwiki-governance normalizes line endings, and its test asserts a passing exit. Strip the
# CRLF and that test still PASSES while no longer testing CRLF at all: a silently weakened gate.
scripts/__tests__/fixtures/** -text
# Same reason for the pdlc server's fixtures: a web-form body carries the browser's CRLF (feature 014).
mcp-servers/pdlc/tests/**/fixtures/** -text
