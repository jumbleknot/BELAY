{
  "$schema": "../node_modules/nx/schemas/project-schema.json",
  "name": "scripts",
  "projectType": "library",
  "sourceRoot": "scripts",
  "targets": {
    "lint": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "{workspaceRoot}",
        "parallel": false,
        "commands": [
          "node scripts/check-speckit-overrides.mjs --selftest",
          "node scripts/check-speckit-overrides.mjs",
          "node scripts/check-ci-digest-coverage.mjs --selftest",
          "node scripts/check-ci-digest-coverage.mjs",
          "node scripts/secret-scan.mjs --selftest",
          "node scripts/secret-scan.mjs",
          "node scripts/check-topology-scrub.mjs --selftest",
          "node scripts/check-topology-scrub.mjs",
          "node scripts/check-toolchain-consistency.mjs --selftest",
          "node scripts/check-toolchain-consistency.mjs",
          "node scripts/check-no-inline-secrets.mjs --selftest",
          "node scripts/check-no-inline-secrets.mjs",
          "node scripts/check-no-argv-secrets.mjs --selftest",
          "node scripts/check-no-argv-secrets.mjs",
          "node scripts/check-override-consistency.mjs --selftest",
          "node scripts/check-override-consistency.mjs",
          "node scripts/check-sast-findings.mjs --selftest",
          "node scripts/sast-scan.mjs --selftest",
          "node scripts/check-coverage.mjs --selftest",
          "node scripts/image-scan.mjs --selftest",
          "node scripts/check-image-findings.mjs --selftest",
          "node scripts/check-renovate-config.mjs --selftest",
          "node scripts/refresh-pin-checksum.mjs --selftest",
          "node scripts/check-renovate-config.mjs",
          "node scripts/check-resource-naming.mjs --selftest",
          "node scripts/check-resource-naming.mjs",
          "node scripts/check-openwiki-okf.mjs --selftest",
          "node scripts/check-openwiki-okf.mjs",
          "node scripts/check-openwiki-governance.mjs --selftest",
          "node scripts/check-openwiki-governance.mjs",
          "node scripts/ci-digest-redact.mjs --selftest",
          "node scripts/ci-failure-digest.mjs --selftest",
          "node scripts/ci-status.mjs --selftest",
          "node scripts/gen-egress-policy.mjs --check"
        ]
      }
    },
    "build-devcontainer-image": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "{workspaceRoot}",
        "command": "node scripts/build-devcontainer-image.mjs"
      },
      "metadata": {
        "description": "Build the dev-container toolchain image locally as belay-devcontainer (feature 004). Needs an engine with OPEN egress (CI, or a host engine such as Docker Desktop): never run it inside the sandbox, where rustup's hosts are not allowlisted. The normal path is the devcontainer-image workflow, which publishes a digest-pinned image. See docs/runbooks/devcontainer.md."
      }
    },
    "sast": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "{workspaceRoot}",
        "parallel": false,
        "commands": [
          "node scripts/sast-scan.mjs --scope full",
          "node scripts/check-sast-findings.mjs"
        ]
      },
      "metadata": {
        "description": "SAST + SCA, stage 1: Semgrep over the whole tree and pnpm audit over the lockfile, then the allowlist gate. Keyless; needs uv (uvx) and network access to semgrep.dev, PyPI and the npm registry. Reports land in security/sast/reports/. See docs/runbooks/sast.md."
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "{workspaceRoot}",
        "command": "node scripts/check-coverage.mjs --run"
      }
    }
  }
}
